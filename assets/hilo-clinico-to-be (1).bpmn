<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_hilo_clinico" targetNamespace="http://hiloclinico.co/bpmn">
  <bpmn:collaboration id="colaboracion_hilo_clinico">
    <bpmn:participant id="pool_atencion" name="Atención de urgencias con Hilo Clínico" processRef="proceso_atencion_urgencias" />
    <bpmn:participant id="pool_fuentes" name="Sistemas de la red: EPS, IPS y laboratorios" />
    <bpmn:participant id="pool_ihce" name="IHCE del Ministerio de Salud" />
    <bpmn:messageFlow id="m1" name="Consulta FHIR" sourceRef="t_fhir" targetRef="pool_fuentes" />
    <bpmn:messageFlow id="m2" name="Recursos" sourceRef="pool_fuentes" targetRef="t_fhir" />
    <bpmn:messageFlow id="m3" name="RDA" sourceRef="t_cerrar" targetRef="pool_ihce" />
    <bpmn:messageFlow id="m4" name="Bundle FHIR" sourceRef="t_envio" targetRef="pool_fuentes" />
    <bpmn:messageFlow id="m5" name="201 Created" sourceRef="pool_fuentes" targetRef="t_envio" />
  </bpmn:collaboration>
  <bpmn:process id="proceso_atencion_urgencias" name="Atención de urgencias con Hilo Clínico" isExecutable="false">
    <bpmn:laneSet id="carriles">
      <bpmn:lane id="lane_medico" name="Médico de urgencias">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_buscar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_atender</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_hilo" name="Hilo Clínico">
        <bpmn:flowNodeRef>t_mpi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_urg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_emerg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_solic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_aut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fhir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_paciente" name="Paciente">
        <bpmn:flowNodeRef>t_resp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Llega a urgencias">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t_buscar" name="Buscar paciente por documento">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t_mpi" name="Identificar en índice maestro">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_urg" name="¿Urgencia vital?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_emerg" name="Abrir acceso de emergencia">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="t_solic" name="Pedir permiso a la paciente">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="t_resp" name="Responder solicitud en la app">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_aut" name="¿Autoriza?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_no" name="Acceso denegado">
      <bpmn:incoming>f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_join">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_fhir" name="Traer y unir datos vía FHIR">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="t_atender" name="Revisar historia y atender">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_dest" name="¿Dónde se registra?">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_guardar" name="Guardar en Hilo Clínico">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t_envio" name="Enviar atención vía FHIR a la IPS">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_dj">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_cerrar" name="Auditar y enviar RDA">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_ok" name="Atención registrada">
      <bpmn:incoming>f14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_buscar" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_buscar" targetRef="t_mpi" />
    <bpmn:sequenceFlow id="f3" sourceRef="t_mpi" targetRef="g_urg" />
    <bpmn:sequenceFlow id="f4" name="No" sourceRef="g_urg" targetRef="t_solic" />
    <bpmn:sequenceFlow id="f5" name="Sí" sourceRef="g_urg" targetRef="t_emerg" />
    <bpmn:sequenceFlow id="f6" sourceRef="t_solic" targetRef="t_resp" />
    <bpmn:sequenceFlow id="f7" sourceRef="t_resp" targetRef="g_aut" />
    <bpmn:sequenceFlow id="f8" name="Sí" sourceRef="g_aut" targetRef="g_join" />
    <bpmn:sequenceFlow id="f9" name="No" sourceRef="g_aut" targetRef="end_no" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_emerg" targetRef="g_join" />
    <bpmn:sequenceFlow id="f11" sourceRef="g_join" targetRef="t_fhir" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_fhir" targetRef="t_atender" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_atender" targetRef="g_dest" />
    <bpmn:sequenceFlow id="f15" name="Hilo Clínico" sourceRef="g_dest" targetRef="t_guardar" />
    <bpmn:sequenceFlow id="f16" name="IPS" sourceRef="g_dest" targetRef="t_envio" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_guardar" targetRef="g_dj" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_envio" targetRef="g_dj" />
    <bpmn:sequenceFlow id="f19" sourceRef="g_dj" targetRef="t_cerrar" />
    <bpmn:sequenceFlow id="f14" sourceRef="t_cerrar" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagrama_to_be" name="Proceso TO-BE">
    <bpmndi:BPMNPlane id="plano_to_be" bpmnElement="colaboracion_hilo_clinico">
